# Copier en .env puis remplir les 3 premières lignes. Ne JAMAIS publier .env (ignoré par Git).
# Pas de guillemets autour des valeurs (compatibilité avec `docker run --env-file`).
XTREAM_URL=http://votre-serveur-xtream:80
XTREAM_USERNAME=REMPLACER_UTILISATEUR
XTREAM_PASSWORD=REMPLACER_MOT_DE_PASSE

# --- Tout le reste est facultatif ---
# Dossier hôte des données (playlists.json + cache EPG). Sur Unraid : /mnt/user/appdata/xtream-m3u-local
DATA_PATH=./data
# Adresse à écrire dans les playlists si la détection automatique ne convient pas (ex. http://192.168.1.10:7777)
PUBLIC_BASE_URL=
# Protège le port 7777 : les lecteurs devront utiliser ...m3u?token=VALEUR
ACCESS_TOKEN=
# Protège l'interface Web (port 7778) par mot de passe (utilisateur WEB_USERNAME)
WEB_USERNAME=admin
WEB_PASSWORD=
# Guide des programmes (xmltv.php du fournisseur), filtré par playlist
ENABLE_EPG=true
# Durée de cache du catalogue en secondes
CACHE_SECONDS=1800
TZ=Europe/Paris
