# Copier en .env, puis saisir tes informations (ne JAMAIS publier le .env sur GitHub).
XTREAM_URL=http://votre-serveur-xtream:80
XTREAM_USERNAME=REMPLACER_UTILISATEUR
XTREAM_PASSWORD=REMPLACER_MOT_DE_PASSE

# Laisser vide pour utiliser automatiquement l'adresse de l'appareil qui consulte la playlist.
# Exemple : http://192.168.1.10:7777
PUBLIC_BASE_URL=

# Pour usage local privé, vide par défaut. En option, protège les URLs par ?token=...
ACCESS_TOKEN=

# EPG/XMLTV facultatif si le fournisseur a un endpoint xmltv.php fonctionnel.
ENABLE_EPG=false

# Interface de gestion sur 7778 ; définir un mot de passe si réseau partagé.
WEB_USERNAME=admin
WEB_PASSWORD=
