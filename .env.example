# Copier en .env puis remplir les 3 premières lignes. Ne JAMAIS publier .env (ignoré par Git).
# Pas de guillemets autour des valeurs (compatibilité avec `docker run --env-file`).
XTREAM_URL=http://votre-serveur-xtream:80
XTREAM_USERNAME=REMPLACER_UTILISATEUR
XTREAM_PASSWORD=REMPLACER_MOT_DE_PASSE

# --- Tout le reste est facultatif ---
# Dossier hôte des données (playlists.json + cache EPG). Sur Unraid : /mnt/user/appdata/xtream-m3u-local
DATA_PATH=./data
# Adresse à écrire dans les playlists si la détection automatique ne convient pas (ex. http://192.168.1.10:7777)
PUBLIC_BASE_URL=
# Protège le port 7777 : les lecteurs devront utiliser ...m3u?token=VALEUR
ACCESS_TOKEN=
# Protège l'interface Web (port 7778) par mot de passe (utilisateur WEB_USERNAME)
WEB_USERNAME=admin
WEB_PASSWORD=
# Guide des programmes (xmltv.php du fournisseur), filtré par playlist
ENABLE_EPG=true
# auto (xmltv.php + API chaîne par chaîne pour les manquantes), xmltv (xmltv.php seul) ou api (API seule)
EPG_SOURCE=auto
# Guide XMLTV externe à utiliser à la place de xmltv.php (facultatif)
EPG_URL=
# Connexions simultanées chez le fournisseur : auto (valeur de l'abonnement), 0 (illimité) ou un nombre
MAX_CONNECTIONS=auto
# Limite atteinte : true = couper le flux le plus ancien (ou celui du même appareil), false = refuser
STREAM_TAKEOVER=true
# Partager une même connexion fournisseur MPEG-TS quand plusieurs écrans regardent la même chaîne en direct
SHARE_STREAMS=true
# Bascule automatique (option de playlist) : version suivante si le flux est muet N secondes (2 à 60)
FAILOVER_STALL_SECONDS=6
# … ou si son débit tombe sous ce pourcentage du meilleur débit observé (0 = désactivé)
FAILOVER_SLOW_PERCENT=35
# Bascule : reconnect (le lecteur se reconnecte sur la bonne version) ou splice (même flux, peut figer l'image)
FAILOVER_MODE=reconnect
# … puis retenter la meilleure version après N minutes sur une version de secours (0 = jamais)
FAILOVER_RETURN_MINUTES=10
# Accès distant (famille) : false = réseau local seulement. true = code d'appareil obligatoire hors du réseau local
REMOTE_ACCESS=false
# Reverse proxy (Traefik, Nginx Proxy Manager) dont on lit X-Forwarded-For, ex. 172.18.0.0/16
TRUSTED_PROXIES=
# Interface Web hors du réseau local (exige WEB_PASSWORD) : déconseillé
WEB_REMOTE=false
# Mises à jour lourdes (films, séries, épisodes) la nuit, heure locale (TZ) ; vide = à toute heure
NIGHTLY_REFRESH=3-6
# Épisodes de séries : cache (heures) et demandes par seconde au fournisseur
SERIES_CACHE_HOURS=168
SERIES_PER_SECOND=2
# Secondes sans appel « guide par chaîne » au démarrage
EPG_STARTUP_QUIET=120
# Appels « guide par chaîne » par seconde au fournisseur (0 = sans limite)
EPG_API_PER_SECOND=2
# Guides XMLTV externes (avant les appels API chaîne par chaîne), séparés par des virgules
EPG_EXTRA_URLS=
# Réseaux en plus considérés comme locaux, ex. 100.64.0.0/10 (Tailscale avec uniquement tes appareils)
LOCAL_NETWORKS=
# Noms de domaine acceptés pour l'interface en plus des IP et noms locaux (protection DNS rebinding)
ALLOWED_HOSTS=
# User agent propre à un abonnement de la configuration (XTREAM_URL_2…), vide = XTREAM_USER_AGENT
XTREAM_USER_AGENT_2=
# Logos haute qualité : pays (codes à 2 lettres) des logos mis en cache ; vide = désactivé
LOGO_COUNTRIES=FR,BE,MA
# Fuseau horaire du serveur Xtream pour le replay (vide = annoncé par le fournisseur), ex. Europe/Paris
PROVIDER_TIMEZONE=
# Nom affiché du fournisseur principal
XTREAM_NAME=
# Abonnements supplémentaires (facultatif, jusqu'à _9) : catalogues fusionnés
# XTREAM_URL_2=http://autre-fournisseur:8080
# XTREAM_USERNAME_2=
# XTREAM_PASSWORD_2=
# XTREAM_NAME_2=Fournisseur 2
# Durée de cache du catalogue en secondes
CACHE_SECONDS=1800
TZ=Europe/Paris
